# Build from the repository root:
#   docker build -f iac/awscloud/ecs-container/Dockerfile.awscloud -t aker-cloud .
FROM tensorflow/tensorflow:2.21.0

ARG AKER_USER=aker
ARG AKER_UID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /usr/local/bin/uv

WORKDIR /aker
COPY requirements.txt ./requirements.txt
RUN uv pip install --system -r requirements.txt

COPY algo/ ./algo/
COPY bus/ ./bus/
COPY changeit/ ./changeit/
COPY cloud/ ./cloud/
COPY prutil/ ./prutil/

RUN useradd --create-home --uid ${AKER_UID} --shell /bin/sh ${AKER_USER} \
    && chown -R ${AKER_USER}:${AKER_USER} /aker /home/${AKER_USER}

USER ${AKER_USER}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_ENABLE_ONEDNN_OPTS=0 \
    TF_CPP_MIN_LOG_LEVEL=3 \
    KERAS_HOME=/home/${AKER_USER}/.keras

# pretrained weights are baked in so a task start does not download them
RUN python -c 'from tensorflow.keras.applications import ResNet50; ResNet50(weights="imagenet")'

# exec form keeps python as PID 1 so it receives SIGTERM from ECS
CMD ["python", "-m", "cloud.main"]
